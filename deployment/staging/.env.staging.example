# Compose identity and paths. Copy this file to .env.staging on the server.
COMPOSE_PROJECT_NAME=zunopixel-staging
ZUNO_PIXEL_APP_DIR=/opt/zunopixel/app/site
ZUNO_PIXEL_DOCKERFILE=/opt/zunopixel/staging/Dockerfile.web
ZUNO_PIXEL_IMAGE=zunopixel-staging-web:local
ZUNO_WEB_HOST_PORT=3100

# Private staging database. Use a URL-safe password in both values.
POSTGRES_DB=zunopixel_staging
POSTGRES_USER=zunopixel_staging
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_RUNTIME=postgres
DATABASE_URL=postgresql://zunopixel_staging:replace-with-a-long-random-password@postgres:5432/zunopixel_staging
DATABASE_POOL_SIZE=10

# Standalone identity. Generate the session secret with `openssl rand -base64 32`
# and convert it to unpadded base64url. Register the callback URL shown below.
IDENTITY_RUNTIME=oidc
APP_BASE_URL=https://staging.zunopixel.com.au
OIDC_ISSUER=https://identity.example.com/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_PROVIDER_ID=company-oidc
OIDC_SESSION_SECRET=
OIDC_SESSION_TTL_SECONDS=28800

# Public application configuration.
NEXT_PUBLIC_SITE_URL=https://staging.zunopixel.com.au
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_ABN=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SALES_EMAIL=
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Runtime-only integrations. Empty values deliberately fail closed.
LEAD_DELIVERY_URL=
LEAD_DELIVERY_TOKEN=
STRIPE_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_LIVE_ENABLED=false
AGENT_PLATFORM_BASE_URL=
AGENT_PLATFORM_ACCESS_TOKEN=

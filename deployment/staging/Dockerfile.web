FROM node:22.13.0-bookworm-slim AS build

WORKDIR /app

ARG NEXT_PUBLIC_SITE_URL=https://zunopixel.com.au
ARG NEXT_PUBLIC_LEGAL_NAME
ARG NEXT_PUBLIC_ABN
ARG NEXT_PUBLIC_SUPPORT_EMAIL
ARG NEXT_PUBLIC_SALES_EMAIL
ARG NEXT_PUBLIC_PHONE
ARG NEXT_PUBLIC_LINKEDIN_URL
ARG NEXT_PUBLIC_INSTAGRAM_URL
ARG NEXT_PUBLIC_FACEBOOK_URL
ARG NEXT_PUBLIC_GA4_MEASUREMENT_ID

ENV NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL} \
    NEXT_PUBLIC_LEGAL_NAME=${NEXT_PUBLIC_LEGAL_NAME} \
    NEXT_PUBLIC_ABN=${NEXT_PUBLIC_ABN} \
    NEXT_PUBLIC_SUPPORT_EMAIL=${NEXT_PUBLIC_SUPPORT_EMAIL} \
    NEXT_PUBLIC_SALES_EMAIL=${NEXT_PUBLIC_SALES_EMAIL} \
    NEXT_PUBLIC_PHONE=${NEXT_PUBLIC_PHONE} \
    NEXT_PUBLIC_LINKEDIN_URL=${NEXT_PUBLIC_LINKEDIN_URL} \
    NEXT_PUBLIC_INSTAGRAM_URL=${NEXT_PUBLIC_INSTAGRAM_URL} \
    NEXT_PUBLIC_FACEBOOK_URL=${NEXT_PUBLIC_FACEBOOK_URL} \
    NEXT_PUBLIC_GA4_MEASUREMENT_ID=${NEXT_PUBLIC_GA4_MEASUREMENT_ID}

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM node:22.13.0-bookworm-slim AS runtime

WORKDIR /app

ENV NODE_ENV=production \
    HOSTNAME=0.0.0.0 \
    PORT=3000

COPY --from=build --chown=node:node /app /app

USER node

EXPOSE 3000

CMD ["npm", "run", "start"]

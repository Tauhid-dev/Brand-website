{
  "$id": "https://project-genesis.dev/schemas/v1/agent.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "constraints": {"items": {"type": "string"}, "minItems": 1, "type": "array"},
    "id": {"pattern": "^[a-z][a-z0-9-]*$", "type": "string"},
    "inputs": {"items": {"type": "string"}, "minItems": 1, "type": "array"},
    "mission": {"minLength": 10, "type": "string"},
    "outputs": {"items": {"type": "string"}, "minItems": 1, "type": "array"},
    "quality_gates": {"items": {"type": "string"}, "minItems": 1, "type": "array"},
    "responsibilities": {"items": {"type": "string"}, "minItems": 1, "type": "array"}
  },
  "required": ["id", "mission", "inputs", "outputs", "responsibilities", "constraints", "quality_gates"],
  "type": "object"
}

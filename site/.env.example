# Public, build-time marketing metadata
NEXT_PUBLIC_SITE_URL=https://zunopixel.com.au
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_ABN=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SALES_EMAIL=
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Runtime selection. OpenAI Sites uses d1 + siwc; standalone OCI uses postgres + oidc.
DATABASE_RUNTIME=d1
DATABASE_URL=
DATABASE_POOL_SIZE=10
IDENTITY_RUNTIME=siwc
APP_BASE_URL=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_PROVIDER_ID=
OIDC_SESSION_SECRET=
OIDC_SESSION_TTL_SECONDS=28800

# Server-side provider configuration (values belong in the hosting secret store)
LEAD_DELIVERY_URL=
LEAD_DELIVERY_TOKEN=
STRIPE_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_LIVE_ENABLED=false
AGENT_PLATFORM_BASE_URL=
AGENT_PLATFORM_ACCESS_TOKEN=
